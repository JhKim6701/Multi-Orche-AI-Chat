MOAC_ENV=dev
# Runtime priority: PostgreSQL + Qdrant + Host Ollama
# In desktop mode, set MOAC_ENV=desktop and optionally override MOAC_DATA_ROOT
MOAC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multi_orche
# SQLite fallback is for local single-process dev convenience only:
# MOAC_DATABASE_URL=sqlite+pysqlite:///./multi_orche.db
MOAC_OLLAMA_BASE_URL=http://localhost:11434
MOAC_QDRANT_URL=http://localhost:6333
MOAC_QDRANT_COLLECTION=moac_asset_chunks
MOAC_DATA_ROOT=./data
MOAC_UPLOAD_ROOT=./data/uploads
MOAC_MAX_UPLOAD_MB=25
MOAC_AUTO_CREATE_TABLES=true
MOAC_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MOAC_RAG_RETRIEVE_TOP_K=8
MOAC_RAG_PACK_MAX_CHARS=2600
MOAC_OCR_ENABLED=true
VITE_API_BASE_URL=http://localhost:8000
